// use prisma-8

model User {
  id        Int                @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  status    Boolean            @default(true)
  posts     Post[]
  createdAt DateTime           @default(now()) @onCreate(now())
  updatedAt temporal.UpdatedAt
  @@map("user")
}

model Post {
  id        Int                @id @default(autoincrement())
  slug      String
  title     String
  status    PostStatus         @default(DRAFT)
  body      String?
  author    User               @relation(fields: [authorId], references: [id])
  authorId  Int
  cover     String
  tags      String             @default("")
  createdAt DateTime           @default(now()) @onCreate(now())
  updatedAt temporal.UpdatedAt
  @@map("post")
}

enum PostStatus {
  // Block keys and attributes
  PUBLISHED
  DRAFT
}